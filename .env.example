# ==============================================================================
# DropLink — Configuração de Ambiente (.env.example)
# Copie para .env e preencha valores reais apenas na VPS (nunca commitar .env).
# ==============================================================================

# Ambiente da aplicação
APP_ENV=production
APP_URL=https://SEU-DOMINIO
APP_HOST=127.0.0.1
APP_PORT=8080

# Autenticação pessoal e segurança de sessão
# Defina uma senha forte; o backend armazena apenas o hash Argon2id.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
SESSION_SECRET=TROQUE-POR-UM-SEGREDO-ALEATORIO-DE-64-CHARS
COOKIE_SECURE=true
# Para desenvolvimento local sem HTTPS: COOKIE_SECURE=false

# Integração com a instância existente do Cobalt (não destruir/substituir)
# URL usada pelos containers (backend/worker): ex.: http://cobalt:9000 (rede externa) ou http://host.docker.internal:9000
COBALT_API_URL=http://host.docker.internal:9000
# URL usada pelo script no host (ops/update-cobalt.sh) para validar readiness do Cobalt
COBALT_HOST_HEALTH_URL=http://127.0.0.1:9000
COBALT_API_KEY=
# Nome da rede Docker externa onde o Cobalt existente está conectado (quando usar compose.cobalt-net.yml)
COBALT_EXTERNAL_NETWORK=cobalt_default

# Configuração do atualizador controlado do Cobalt (executado no host via systemd)
COBALT_COMPOSE_FILE=/CAMINHO/REAL/compose.yml
COBALT_SERVICE=cobalt
COBALT_IMAGE_REPO=ghcr.io/imputnet/cobalt
COBALT_IMAGE_TAG=11
COBALT_UPDATE_INTERVAL_MINUTES=30
COBALT_DRAIN_TIMEOUT_SECONDS=120
COBALT_READINESS_TIMEOUT_SECONDS=90
COBALT_REJECTED_COOLDOWN_HOURS=24
# URL pública opcional para smoke test pós-atualização do Cobalt (deixe vazio para pular)
COBALT_SMOKE_TEST_URL=

# Caminhos nos containers e diretórios persistentes no host
DATABASE_PATH=/app/data/droplink.db
STORAGE_DIR=/app/storage
TMP_DIR=/app/tmp
ROUTES_CONFIG_PATH=/app/config/routes.yaml
FRONTEND_DIST_DIR=/app/frontend/dist
COBALT_STATUS_FILE=/app/ops-status/cobalt-updater-status.json

HOST_OPS_STATUS_DIR=./data/ops-status
HOST_SQLITE_DIR=./data/db
HOST_STORAGE_DIR=./data/storage
HOST_BACKUPS_DIR=./backups
DROPLINK_DB_PATH=./data/db/droplink.db

# Limites operacionais (ajustar conforme capacidade real da VPS)
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS_PER_USER=20
MAX_JOB_SIZE_MB=500
MAX_CAROUSEL_ITEMS=50
MAX_JOB_DURATION_SECONDS=600
MIN_FREE_DISK_MB=2048
FILE_RETENTION_HOURS=24
HISTORY_RETENTION_DAYS=30
EMBEDDED_WORKER=false

# Motores no worker
# Nightly do yt-dlp é opt-in; padrão usa apenas releases estáveis pinadas no build.
ALLOW_YTDLP_NIGHTLY=false
LOG_LEVEL=INFO
