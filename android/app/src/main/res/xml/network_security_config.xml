<?xml version="1.0" encoding="utf-8"?>
<!--
    Devwolf Downloader: HTTPS-only for the Java/WebView network stacks.
    SafeHttpClient upgrades http:// platform/media URLs to https:// before connecting.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
